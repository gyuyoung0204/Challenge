# 관리자 PIN (필수, 미설정 시 관리자 기능 잠금)
ADMIN_PIN=
# 관리자 쿠키 서명용 임의 문자열 (배포 시 필수)
SESSION_SECRET=

# 구글 시트 (기본값: 현재 챌린지 시트)
SHEET_ID=
# SHEET_GID=0              # 「참가자 정보」 탭
# SHEET_LOG_GID=1065201099 # 「진행성적」 탭

# 시트 쓰기용 Apps Script 웹앱 (google-apps-script/Code.gs 배포 후 입력)
SHEET_WEBAPP_URL=
SHEET_WEBAPP_SECRET=
